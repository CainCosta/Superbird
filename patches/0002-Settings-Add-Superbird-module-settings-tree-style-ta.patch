+void SettingsUI::set_superbird_module_enabled(JsonValue const& data)
+{
+    if (!data.is_object())
+        return;
+
+    auto id = data.as_object().get_string("id"sv);
+    auto enabled = data.as_object().get_bool("enabled"sv);
+    if (!id.has_value() || id->is_empty() || !enabled.has_value())
+        return;
+
+    Application::settings().set_superbird_module_enabled(*id, *enabled);
+}
