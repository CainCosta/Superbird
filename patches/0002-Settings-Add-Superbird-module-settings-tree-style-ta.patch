+SuperbirdSettings Settings::parse_superbird_settings(JsonValue const& settings)
+{
+    if (!settings.is_object())
+        return {};
+
+    SuperbirdSettings superbird_settings;
+    if (auto modules = settings.as_object().get_object(SUPERBIRD_MODULES_KEY); modules.has_value()) {
+        modules->for_each_member([&](auto const& key, auto const& value) {
+            if (!key.is_empty() && value.is_bool())
+                superbird_settings.enabled_modules.set(key, value.as_bool());
+        });
+    }
+    return superbird_settings;
+}
+
+void Settings::set_superbird_settings(SuperbirdSettings superbird_settings)
+{
+    m_superbird_settings = move(superbird_settings);
+    persist_settings();
+
+    for (auto& observer : m_observers)
+        observer.superbird_settings_changed();
+}
+
+void Settings::set_superbird_module_enabled(String const& module_id, bool enabled)
+{
+    if (module_id.is_empty())
+        return;
+
+    m_superbird_settings.enabled_modules.set(module_id, enabled);
+    persist_settings();
+
+    for (auto& observer : m_observers)
+        observer.superbird_settings_changed();
+}
