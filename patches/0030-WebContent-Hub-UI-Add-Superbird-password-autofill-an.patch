+void WebContentPage::did_update_autofill_focused_field(Web::HTML::CrossProcessId frame_id, Optional<URL::Origin> frame_origin, u8 field_kind, Optional<Web::DevicePixelRect> input_rect, bool has_username, bool has_password)
+{
+    auto& traversable = view().traversable();
+    auto host = traversable.focused_navigable_host();
+    if (host != *this)
+        return;
+    if (input_rect.has_value())
+        input_rect->translate_by(traversable.focused_navigable_host_offset());
+    view().did_update_autofill_focused_field({}, frame_id, move(frame_origin), field_kind, input_rect, has_username, has_password);
+}
+
+void WebContentPage::did_submit_credentials(URL::Origin origin, Utf16String username, Utf16String password)
+{
+    view().did_submit_credentials({}, move(origin), move(username), move(password));
+}
