+Utf16String Internals::inspect_autofill_focused_field()
+{
+    auto info = Web::Superbird::inspect_focused_field(page());
+    JsonObject obj;
+    obj.set("kind"_string, static_cast<u64>(to_underlying(info.field_kind)));
+    obj.set("origin"_string, info.frame_origin.has_value() ? info.frame_origin->serialize() : String {});
+    obj.set("hasUsername"_string, info.has_username);
+    obj.set("hasPassword"_string, info.has_password);
+    obj.set("hasRect"_string, info.input_rect.has_value());
+    return Utf16String::from_utf8(obj.serialized());
+}
+
+bool Internals::fill_autofill_credentials(Utf16String const& expected_origin_url, Utf16String const& username, Utf16String const& password)
+{
+    auto parsed = URL::Parser::basic_parse(expected_origin_url.to_utf8());
+    if (!parsed.has_value())
+        return false;
+    return Web::Superbird::fill_credentials(page(), {}, parsed->origin(), username, password);
+}
+
+bool Internals::fill_autofill_focused_field(Utf16String const& expected_origin_url, Utf16String const& value)
+{
+    auto parsed = URL::Parser::basic_parse(expected_origin_url.to_utf8());
+    if (!parsed.has_value())
+        return false;
+    return Web::Superbird::fill_focused_field(page(), {}, parsed->origin(), value);
+}
+
+Utf16String Internals::extract_submitted_credentials(HTML::HTMLFormElement& form)
+{
+    auto submitted = Web::Superbird::extract_submitted_credentials(form);
+    if (!submitted.has_value())
+        return "{}"_utf16;
+    JsonObject obj;
+    obj.set("origin"_string, submitted->origin.serialize());
+    obj.set("username"_string, submitted->username.to_utf8());
+    obj.set("password"_string, submitted->password.to_utf8());
+    return Utf16String::from_utf8(obj.serialized());
+}
