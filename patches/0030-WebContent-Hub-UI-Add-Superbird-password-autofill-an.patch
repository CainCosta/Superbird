+void ViewImplementation::fill_credentials(Web::HTML::CrossProcessId frame_id, URL::Origin const& expected_origin, Utf16String const& username, Utf16String const& password)
+{
+    if (frame_id != Web::HTML::CrossProcessId {}) {
+        if (auto navigable = traversable().find(frame_id); navigable.has_value()) {
+            if (auto page = traversable().page_hosting(*navigable))
+                page->async_fill_credentials(frame_id, expected_origin, username, password);
+        }
+        return;
+    }
+    focused_navigable_host().async_fill_credentials(frame_id, expected_origin, username, password);
+}
+
+void ViewImplementation::fill_focused_field(Web::HTML::CrossProcessId frame_id, URL::Origin const& expected_origin, Utf16String const& value)
+{
+    if (frame_id != Web::HTML::CrossProcessId {}) {
+        if (auto navigable = traversable().find(frame_id); navigable.has_value()) {
+            if (auto page = traversable().page_hosting(*navigable))
+                page->async_fill_focused_field(frame_id, expected_origin, value);
+        }
+        return;
+    }
+    focused_navigable_host().async_fill_focused_field(frame_id, expected_origin, value);
+}
+
+void ViewImplementation::did_update_autofill_focused_field(Badge<WebContentPage>, Web::HTML::CrossProcessId frame_id, Optional<URL::Origin> frame_origin, u8 field_kind, Optional<Web::DevicePixelRect> input_rect, bool has_username, bool has_password)
+{
+    if (on_autofill_focused_field_change)
+        on_autofill_focused_field_change(frame_id, frame_origin, field_kind, input_rect, has_username, has_password);
+}
+
+void ViewImplementation::did_submit_credentials(Badge<WebContentPage>, URL::Origin origin, Utf16String username, Utf16String password)
+{
+    if (on_submit_credentials)
+        on_submit_credentials(origin, username, password);
+}
