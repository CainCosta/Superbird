@@ -173,6 +174,10 @@ public:
     Tab* tab_at(int index) const { return m_tabs_container->tab(index); }
     TabWidget& tab_widget() const { return *m_tabs_container; }
     Superbird::WindowHost& superbird() const { return *m_superbird; }
+    // Superbird: Selects the tab of the given number (0-8, where 8 is the last tab) among the tabs that show.
+    void select_tab_by_number(int number);
+    // Superbird Workspaces takes Cmd/Ctrl+1-9 for itself, leaving Cmd/Ctrl+Shift+1-9 to select tabs.
+    void set_plain_tab_number_shortcuts_enabled(bool);
     WindowToolbar& toolbar() const { return m_tabs_container->toolbar(); }
     BookmarksBar& bookmarks_bar() const { return m_tabs_container->bookmarks_bar(); }
     // Closes a tab that isn't worth reopening, such as an empty tab that other tabs took the place of.
@@ -349,6 +354,8 @@ private:
     WebView::IsPrivate m_is_private { WebView::IsPrivate::No };
 
     TabWidget* m_tabs_container { nullptr };
+    // NB: Declared before the WindowHost, so its modules can still reach these while they go.
+    Vector<QPointer<QShortcut>> m_plain_tab_number_shortcuts;
     NonnullOwnPtr<Superbird::WindowHost> m_superbird;
     Tab* m_current_tab { nullptr };
     Array<QPointer<PageCard>, 2> m_page_cards;
