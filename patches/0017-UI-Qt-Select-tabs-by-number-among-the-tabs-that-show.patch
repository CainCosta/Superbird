From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 08:53:13 -0600
Subject: [PATCH] UI/Qt: Select tabs by number among the tabs that show, with
 Shift

Cmd/Ctrl+Shift+1-9 select a tab by its number, counting only the tabs
that show, so a tab another Superbird workspace hides is never picked.
Cmd/Ctrl+1-9 do the same unless Superbird Workspaces takes them for
switching workspaces. The All Tabs popover also leaves hidden tabs out.

diff --git a/UI/Qt/BrowserWindow.cpp b/UI/Qt/BrowserWindow.cpp
index dd3d8f2d..20f6e514 100644
--- a/UI/Qt/BrowserWindow.cpp
+++ b/UI/Qt/BrowserWindow.cpp
@@ -516,17 +516,35 @@ void BrowserWindow::initialize_application_actions()
     addAction(application.reset_zoom_action());
     addAction(application.quit_action());
 
-    for (int i = 0; i < 8; ++i) {
-        new QShortcut(QKeySequence(Qt::CTRL | static_cast<Qt::Key>(Qt::Key_1 + i)), this, [this, i]() {
-            if (m_tabs_container->count() > 1)
-                m_tabs_container->set_current_index(min(i, m_tabs_container->count() - 1));
-        });
+    // Superbird: Cmd/Ctrl+Shift+1-9 select a tab by its number, and so do Cmd/Ctrl+1-9 unless a Superbird module
+    //            (Workspaces) takes them.
+    for (int i = 0; i < 9; ++i) {
+        auto key = static_cast<Qt::Key>(Qt::Key_1 + i);
+        new QShortcut(QKeySequence(Qt::CTRL | Qt::SHIFT | key), this, [this, i]() { select_tab_by_number(i); });
+        m_plain_tab_number_shortcuts.append(new QShortcut(QKeySequence(Qt::CTRL | key), this, [this, i]() { select_tab_by_number(i); }));
     }
+}
 
-    new QShortcut(QKeySequence(Qt::CTRL | Qt::Key_9), this, [this]() {
-        if (m_tabs_container->count() > 1)
-            m_tabs_container->set_current_index(m_tabs_container->count() - 1);
-    });
+void BrowserWindow::select_tab_by_number(int number)
+{
+    // Superbird: Only the tabs that show count, so a tab another workspace hides is never picked. Nine is the last tab.
+    Vector<int> indices;
+    for (int index = 0; index < m_tabs_container->count(); ++index) {
+        if (auto* tab = tab_at(index); tab && !m_superbird->is_tab_hidden(*tab))
+            indices.append(index);
+    }
+    if (indices.size() < 2)
+        return;
+    auto position = number == 8 ? indices.size() - 1 : min(static_cast<size_t>(number), indices.size() - 1);
+    m_tabs_container->set_current_index(indices[position]);
+}
+
+void BrowserWindow::set_plain_tab_number_shortcuts_enabled(bool enabled)
+{
+    for (auto& shortcut : m_plain_tab_number_shortcuts) {
+        if (shortcut)
+            shortcut->setEnabled(enabled);
+    }
 }
 
 void BrowserWindow::initialize_application_menu()
