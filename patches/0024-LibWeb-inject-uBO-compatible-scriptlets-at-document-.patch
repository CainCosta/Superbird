From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:02:57 -0600
Subject: [PATCH] LibWeb: inject uBO-compatible scriptlets at document start
 across all frames


diff --git a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
index f7dbe92a..5e0a3187 100644
--- a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
+++ b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
@@ -29,6 +29,7 @@ pub struct ContentBlockerEngine {
     engine: adblock::engine::Engine,
     generic_selector_list_rules: GenericSelectorListRules,
     is_ubo_mode: bool,
+    missing_resources: std::sync::Arc<std::sync::Mutex<HashSet<String>>>,
 }
 
 #[derive(Default)]
@@ -364,6 +365,7 @@ pub extern "C" fn rust_content_blocker_create(rules: ak::Span<'_, u8>) -> *mut C
             engine,
             generic_selector_list_rules,
             is_ubo_mode: false,
+            missing_resources: std::sync::Arc::new(std::sync::Mutex::new(HashSet::new())),
         };
         Box::into_raw(Box::new(engine))
     })
@@ -374,6 +376,34 @@ pub extern "C" fn rust_content_blocker_is_ubo_mode(engine: Option<&ContentBlocke
     abort_on_panic(|| engine.is_some_and(|engine| engine.is_ubo_mode))
 }
 
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_injected_script(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return string_to_ffi(String::new());
+        };
+        let Some(url) = as_str(url) else {
+            return string_to_ffi(String::new());
+        };
+        string_to_ffi(superbird::injected_script_for_url(engine, url))
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_missing_resources(
+    engine: Option<&ContentBlockerEngine>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return string_to_ffi("[]".to_string());
+        };
+        string_to_ffi(superbird::missing_resources_json(engine))
+    })
+}
+
 /// # Safety
 /// - `engine` must be null or a valid pointer returned by `rust_content_blocker_create`
 #[unsafe(no_mangle)]
diff --git a/Libraries/LibWeb/DOM/Document.cpp b/Libraries/LibWeb/DOM/Document.cpp
index d4058070..11bc5465 100644
--- a/Libraries/LibWeb/DOM/Document.cpp
+++ b/Libraries/LibWeb/DOM/Document.cpp
@@ -1203,6 +1203,38 @@ void Document::invalidate_content_blocker_style_sheet()
     m_content_blocker_style_sheet_checked_ids.clear();
 }
 
+void Document::run_content_blocker_scriptlets()
+{
+    if (m_has_run_content_blocker_scriptlets)
+        return;
+    m_has_run_content_blocker_scriptlets = true;
+
+    if (is_decoded_svg() || !content_blocking_enabled())
+        return;
+
+    auto& blocker = ContentBlocker::the();
+    if (!blocker.has_rules() || !blocker.is_ubo_mode())
+        return;
+
+    auto& settings = relevant_settings_object();
+    if (HTML::is_scripting_disabled(settings))
+        return;
+
+    auto script_source = blocker.injected_script_for_url(fallback_base_url());
+    if (script_source.is_empty())
+        return;
+
+    HTML::TemporaryExecutionContext execution_context { settings };
+    auto script = HTML::ClassicScript::create(
+        "superbird-content-blocker-scriptlet"sv,
+        move(script_source),
+        settings,
+        fallback_base_url(),
+        1,
+        HTML::ClassicScript::MutedErrors::Yes);
+    (void)script->run(HTML::ClassicScript::RethrowErrors::No);
+}
+
 bool Document::content_blocker_style_sheet_may_need_refresh_for_class_or_id(Utf16FlyString const* id, ReadonlySpan<Utf16FlyString> class_names)
 {
     if (is_decoded_svg() || !m_content_blocker_style_sheet.has_value())
@@ -8393,6 +8425,8 @@ void Document::update_for_history_step_application(NonnullRefPtr<HTML::SessionHi
         if (!scrolling_blocked_in_new_document)
             try_to_scroll_to_the_fragment(allow_text_directive_scroll);
 
+        run_content_blocker_scriptlets();
+
         // 4. At this point scripts may run for the newly-created document document.
         set_ready_to_run_scripts();
     }
