         ids_bytes.bytes());
 }
 
+Utf16String ContentBlocker::injected_script_for_url(URL::URL const& url) const
+{
+    if (!has_rules() || !is_ubo_mode())
+        return {};
+
+    auto url_string = serialized_url_for_matching(url);
+
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return {};
+    return take_rust_utf16_string(ContentBlocking::FFI::rust_content_blocker_injected_script(
+        engine,
+        url_string.bytes()));
+}
+
+Utf16String ContentBlocker::missing_resources_json() const
+{
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return "[]"_utf16;
+    return take_rust_utf16_string(ContentBlocking::FFI::rust_content_blocker_missing_resources(engine));
+}
