From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Superbird <superbird@local>
Date: Tue, 24 Nov 2026 04:56:29 -0600
Subject: [PATCH] Superbird: Side-by-side app identity, profile isolation, and
 CMake module flags


diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff886075..1018d689 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -41,6 +41,7 @@ set(LADYBIRD_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
 list(APPEND CMAKE_MODULE_PATH "${LADYBIRD_SOURCE_DIR}/Meta/CMake")
 
 include(cmake_options)
+include(SuperbirdModules)
 include(compile_options)
 include(check_for_dependencies)
 include(ladybird_helper_processes)
diff --git a/Libraries/LibCore/CMakeLists.txt b/Libraries/LibCore/CMakeLists.txt
