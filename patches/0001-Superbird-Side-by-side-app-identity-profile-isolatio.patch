@@ -835,7 +835,7 @@ ErrorOr<void> Application::create_profile([[maybe_unused]] Optional<StringView>
 void Application::create_mach_port_server([[maybe_unused]] ByteString const& profile_identity)
 {
 #if defined(AK_OS_MACOS)
