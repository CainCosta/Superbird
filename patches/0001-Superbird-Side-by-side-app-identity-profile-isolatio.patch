 {
     FreedesktopNotifyArguments arguments;
-    arguments.app_name = "Ladybird"_string;
+    arguments.app_name = "Superbird"_string;
     arguments.replaces_id = replaces_daemon_id;
-    arguments.app_icon = "org.ladybird.Ladybird"_string;
