From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Superbird <superbird@local>
Date: Tue, 24 Nov 2026 18:56:20 -0600
Subject: [PATCH] UI/Qt: Let the tab bar hide tabs, host a sidebar footer, and
 share the profile's data directory with Superbird


diff --git a/UI/Qt/Application.cpp b/UI/Qt/Application.cpp
index c0c88abc..87d46e5e 100644
--- a/UI/Qt/Application.cpp
+++ b/UI/Qt/Application.cpp
@@ -1562,6 +1562,8 @@ void Application::create_session_store(ByteString const& data_directory, bool pe
         on_recently_closed_entries_changed();
     };
 
+    Superbird::WindowHost::set_profile_data_directory(data_directory, persists_sessions);
+
 #if defined(SUPERBIRD_MODULE_TREE_TABS)
     if (persists_sessions) {
         if (auto tree_store = TreeTabStore::create(data_directory); !tree_store.is_error()) {
diff --git a/UI/Qt/BrowserWindow.cpp b/UI/Qt/BrowserWindow.cpp
index f45b31bd..dd3d8f2d 100644
--- a/UI/Qt/BrowserWindow.cpp
+++ b/UI/Qt/BrowserWindow.cpp
@@ -1704,9 +1704,13 @@ void BrowserWindow::open_next_tab()
     if (m_tabs_container->count() <= 1)
         return;
 
-    auto next_index = m_tabs_container->current_index() + 1;
-    if (next_index >= m_tabs_container->count())
-        next_index = 0;
+    // NB: Tabs hidden from the tab bar (another Superbird workspace's) are skipped.
+    auto next_index = m_tabs_container->current_index();
+    for (int step = 0; step < m_tabs_container->count(); ++step) {
+        next_index = (next_index + 1) % m_tabs_container->count();
+        if (m_tabs_container->tab_bar()->isTabVisible(next_index))
+            break;
+    }
     m_tabs_container->set_current_index(next_index);
 }
 
@@ -1715,9 +1719,12 @@ void BrowserWindow::open_previous_tab()
     if (m_tabs_container->count() <= 1)
         return;
 
-    auto next_index = m_tabs_container->current_index() - 1;
-    if (next_index < 0)
-        next_index = m_tabs_container->count() - 1;
+    auto next_index = m_tabs_container->current_index();
+    for (int step = 0; step < m_tabs_container->count(); ++step) {
+        next_index = (next_index - 1 + m_tabs_container->count()) % m_tabs_container->count();
+        if (m_tabs_container->tab_bar()->isTabVisible(next_index))
+            break;
+    }
     m_tabs_container->set_current_index(next_index);
 }
 
diff --git a/UI/Qt/TabBar.cpp b/UI/Qt/TabBar.cpp
index 468e3dd4..fcaa28d4 100644
--- a/UI/Qt/TabBar.cpp
+++ b/UI/Qt/TabBar.cpp
@@ -955,6 +955,26 @@ int TabBar::pinned_tab_count() const
     return pinned_count;
 }
 
+int TabBar::hidden_tab_count(int from_index) const
+{
+    int hidden = 0;
+    for (int index = max(0, from_index); index < count(); ++index) {
+        if (!isTabVisible(index))
+            ++hidden;
+    }
+    return hidden;
+}
+
+int TabBar::visible_tabs_between(int from_index, int to_index) const
+{
+    int visible = 0;
+    for (int index = max(0, from_index); index < min(to_index, count()); ++index) {
+        if (isTabVisible(index))
+            ++visible;
+    }
+    return visible;
+}
+
 void TabBar::recreate_icons()
 {
     m_fallback_tab_icon = create_chrome_icon(ChromeIcon::Globe, Theme::chrome_palette(*this));
@@ -989,7 +1009,7 @@ QSize TabBar::tabSizeHint(int index) const
     if (auto count = this->count(); count > 0) {
         auto pinned_count = pinned_tab_count();
         // The first and last tabs also take room for their feet at the ends of the tab bar.
-        auto end_room = (index == 0 ? HORIZONTAL_TAB_END_ROOM : 0) + (index == count - 1 ? HORIZONTAL_TAB_END_ROOM : 0);
+        auto end_room = (visible_tabs_between(0, index) == 0 ? HORIZONTAL_TAB_END_ROOM : 0) + (visible_tabs_between(index + 1, count) == 0 ? HORIZONTAL_TAB_END_ROOM : 0);
         if (index < pinned_count) {
             hint.setWidth(HORIZONTAL_PINNED_TAB_WIDTH + end_room);
             hint.setHeight(HORIZONTAL_TAB_HEIGHT);
@@ -1023,12 +1043,14 @@ int TabBar::horizontal_tab_share() const
 {
     auto pinned_count = pinned_tab_count();
     auto remaining_width = (m_available_width > 0 ? m_available_width : this->width()) - (pinned_count * HORIZONTAL_PINNED_TAB_WIDTH) - (2 * HORIZONTAL_TAB_END_ROOM);
-    auto sharing_count = count() - pinned_count;
+    auto sharing_count = count() - pinned_count - hidden_tab_count(pinned_count);
     if (sharing_count <= 0)
         return HORIZONTAL_TAB_MIN_WIDTH;
 
     Vector<int, 8> larger_min_widths;
     for (int index = pinned_count; index < count(); ++index) {
+        if (!isTabVisible(index))
+            continue;
         if (auto min_width = horizontal_tab_min_width(index); min_width > HORIZONTAL_TAB_MIN_WIDTH)
             larger_min_widths.append(min_width);
     }
@@ -1787,7 +1809,7 @@ QRect TabBar::incoming_drop_layout_rect(int position) const
     if (tab_layout() != TabLayout::Horizontal)
         return vertical_tab_rect(position, pinned_region_for(pinned_count));
 
-    auto unpinned_count = count() + 1 - pinned_count;
+    auto unpinned_count = count() + 1 - pinned_count - hidden_tab_count(pinned_tab_count());
     auto first_tab_rect = visual_tab_rect(0);
     auto strip_width = visual_tab_rect(count() - 1).right() + 1 - first_tab_rect.left() - (2 * HORIZONTAL_TAB_END_ROOM);
     auto available_width = (m_available_width > 0 ? m_available_width : width()) - (2 * HORIZONTAL_TAB_END_ROOM);
@@ -1817,10 +1839,12 @@ int TabBar::drop_slot_at(QPoint const& position) const
     // group has slots for it. Of those, the slot is the one whose place is nearest.
     auto pinned_count = pinned_tab_count();
     auto dragging_pinned = dragging_pinned_tab();
-    auto nearest_slot = [](int first_slot, int last_slot, QPointF point, auto const& rect_for_slot) {
+    auto nearest_slot = [this](int first_slot, int last_slot, QPointF point, auto const& rect_for_slot) {
         auto best_slot = first_slot;
         auto best_distance = NumericLimits<qreal>::max();
         for (auto slot = first_slot; slot <= last_slot; ++slot) {
+            if (slot < count() && !isTabVisible(slot))
+                continue;
             auto offset = QRectF(rect_for_slot(slot)).center() - point;
             if (auto distance = QPointF::dotProduct(offset, offset); distance < best_distance) {
                 best_distance = distance;
@@ -2687,8 +2711,9 @@ QRect TabBar::vertical_tab_rect(int index, PinnedRegion const& region) const
         return { mix(tile.left(), row_in_column.left()), mix(tile.top(), row_in_column.top()), mix(tile.width(), row_in_column.width()), VERTICAL_TAB_HEIGHT };
     }
 
-    auto unpinned_index = index - region.count;
-    return { vertical_tabs_left(), VERTICAL_TAB_BAR_END_ROOM + region.height + (unpinned_index * VERTICAL_TAB_HEIGHT) - m_scroll_offset, vertical_bar_width(), VERTICAL_TAB_HEIGHT };
+    auto unpinned_row = visible_tabs_between(region.count, index);
+    auto row_height = index < count() && !isTabVisible(index) ? 0 : VERTICAL_TAB_HEIGHT;
+    return { vertical_tabs_left(), VERTICAL_TAB_BAR_END_ROOM + region.height + (unpinned_row * VERTICAL_TAB_HEIGHT) - m_scroll_offset, vertical_bar_width(), row_height };
 }
 
 int TabBar::tab_index_at(QPoint const& position) const
