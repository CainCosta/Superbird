+void TabWidget::set_sidebar_footer_widget(QWidget* widget)
+{
+    if (m_sidebar_footer_widget == widget)
+        return;
+    if (m_sidebar_footer_widget)
+        m_sidebar_footer_widget->hide();
+    m_sidebar_footer_widget = widget;
+    if (widget) {
+        widget->setParent(m_vertical_tab_bar_column);
+        widget->hide();
+    }
+    if (m_vertical_tabs_enabled)
+        rebuild_layout();
+}
