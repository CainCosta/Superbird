+    return { vertical_tab_width(m_available_width, tab_layout()), (2 * VERTICAL_TAB_BAR_END_ROOM) + region.height + (max(0, tab_count - region.count - hidden_tab_count(region.count)) * VERTICAL_TAB_HEIGHT) };
