     if (bundle.is_empty()) {
         if (m_content_blocker_list_buffer.has_value() && m_content_blocker_list_buffer->size() == 0)
diff --git a/UI/Qt/SiteSettingsPopover.cpp b/UI/Qt/SiteSettingsPopover.cpp
index 1d83427e8..021cbe036 100644
--- a/UI/Qt/SiteSettingsPopover.cpp
+++ b/UI/Qt/SiteSettingsPopover.cpp
@@ -4,6 +4,7 @@
  * SPDX-License-Identifier: BSD-2-Clause
  */
 
+#include <LibWebView/SuperbirdContentBlocking.h>
 #include <UI/Qt/ChromeStyle.h>
 #include <UI/Qt/Icon.h>
 #include <UI/Qt/SiteSettingsPopover.h>
@@ -247,9 +248,9 @@ SiteSettingsPopover::SiteSettingsPopover(QWidget* parent, WebView::Settings& set
     blocking_row->setSpacing(10);
     m_content_blocking_icon = create_icon(*m_site_page);
     blocking_row->addWidget(m_content_blocking_icon);
-    auto* blocking_label = new QLabel("Content blocking", m_site_page);
-    blocking_label->setFixedHeight(ROW_HEIGHT);
-    blocking_row->addWidget(blocking_label, 1);
+    m_content_blocking_label = new QLabel("Content blocking", m_site_page);
+    m_content_blocking_label->setFixedHeight(ROW_HEIGHT);
+    blocking_row->addWidget(m_content_blocking_label, 1);
     m_content_blocking_switch = new PopoverSwitch(m_site_page);
     m_content_blocking_switch->setAccessibleName("Content blocking on this site");
     QObject::connect(m_content_blocking_switch, &QCheckBox::toggled, this, [this](bool enabled) {
@@ -259,6 +260,24 @@ SiteSettingsPopover::SiteSettingsPopover(QWidget* parent, WebView::Settings& set
     blocking_row->addWidget(m_content_blocking_switch);
     layout->addLayout(blocking_row);
 
+    m_cosmetic_filtering_row = new QWidget(m_site_page);
+    auto* cosmetic_row_layout = new QHBoxLayout(m_cosmetic_filtering_row);
+    cosmetic_row_layout->setContentsMargins(10, 0, 10, 0);
+    cosmetic_row_layout->setSpacing(10);
+    cosmetic_row_layout->addSpacing(26);
+    auto* cosmetic_label = new QLabel("Cosmetic filtering", m_cosmetic_filtering_row);
+    cosmetic_label->setFixedHeight(ROW_HEIGHT);
+    cosmetic_row_layout->addWidget(cosmetic_label, 1);
+    m_cosmetic_filtering_switch = new PopoverSwitch(m_cosmetic_filtering_row);
+    m_cosmetic_filtering_switch->setAccessibleName("Cosmetic filtering on this site");
+    QObject::connect(m_cosmetic_filtering_switch, &QCheckBox::toggled, this, [this](bool enabled) {
+        if (!m_host.is_empty())
+            WebView::SuperbirdContentBlocking::set_cosmetic_filtering_enabled_for_host(m_settings, m_host, enabled);
+    });
+    cosmetic_row_layout->addWidget(m_cosmetic_filtering_switch);
+    m_cosmetic_filtering_row->hide();
+    layout->addWidget(m_cosmetic_filtering_row);
+
     m_blocked_row = new QPushButton(m_site_page);
     m_blocked_row->setObjectName("LadybirdPopoverRow");
     m_blocked_row->setAccessibleName("Blocked on this page");
@@ -291,9 +310,13 @@ SiteSettingsPopover::SiteSettingsPopover(QWidget* parent, WebView::Settings& set
     m_reset_permissions_link = create_link(*m_site_page, "Reset permissions");
     QObject::connect(m_reset_permissions_link, &QPushButton::clicked, this, [this] {
         m_settings.remove_autoplay_site_filter(m_origin);
-        if (!m_is_private)
+        if (!m_is_private) {
             m_settings.reset_host_setting(WebView::HostSetting::ForceDark, m_host);
+            if (!m_host.is_empty())
+                WebView::SuperbirdContentBlocking::set_cosmetic_filtering_enabled_for_host(m_settings, m_host, true);
+        }
         update_autoplay();
+        update_content_blocking_mode();
         if (on_reset_permissions)
             on_reset_permissions();
     });
@@ -512,11 +535,29 @@ void SiteSettingsPopover::set_permissions(Vector<WebView::SitePermissionRow> con
     fit_to_page();
 }
 
+void SiteSettingsPopover::update_content_blocking_mode()
+{
+    bool ubo_mode = WebView::SuperbirdContentBlocking::is_ubo_mode_enabled(m_settings);
+    if (m_content_blocking_label)
+        m_content_blocking_label->setText(ubo_mode ? "Content blocking (uBO-compatible)" : "Content blocking (Default)");
+
+    if (m_cosmetic_filtering_row && m_cosmetic_filtering_switch) {
+        bool show_cosmetic = ubo_mode && m_site_content_blocking_enabled && !m_host.is_empty();
+        m_cosmetic_filtering_row->setVisible(show_cosmetic);
+        if (show_cosmetic) {
+            QSignalBlocker blocker(m_cosmetic_filtering_switch);
+            m_cosmetic_filtering_switch->setChecked(WebView::SuperbirdContentBlocking::is_cosmetic_filtering_enabled_for_host(m_settings, m_host));
+        }
+    }
+}
+
 void SiteSettingsPopover::set_content_blocking(WebView::ContentBlockingSnapshot const& blocking)
 {
+    m_site_content_blocking_enabled = blocking.enabled();
     QSignalBlocker blocker(m_content_blocking_switch);
     m_content_blocking_switch->setChecked(blocking.enabled());
     m_content_blocking_switch->setEnabled(blocking.can_toggle());
+    update_content_blocking_mode();
 
     // What was blocked is only listed while content blocking is on.
     auto count = qformatted("{}", blocking.blocked_resources.size());
