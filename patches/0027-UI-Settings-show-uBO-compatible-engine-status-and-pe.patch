From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:20:50 -0600
Subject: [PATCH] UI+Settings: show uBO-compatible engine status and per-site
 cosmetic switch


diff --git a/Base/res/ladybird/about-pages/settings.html b/Base/res/ladybird/about-pages/settings.html
index 90a80a0a8..deea9949f 100644
--- a/Base/res/ladybird/about-pages/settings.html
+++ b/Base/res/ladybird/about-pages/settings.html
@@ -1441,6 +1441,12 @@
                         <label for="enable-content-blocking">Block ads, trackers and more</label>
                         <input id="enable-content-blocking" type="checkbox" switch />
                     </div>
+                    <div class="card-group inline-container">
+                        <span id="content-blocker-engine-summary" class="description"></span>
+                        <button id="open-superbird-blocking-settings" class="link-button">
+                            Switch engine in Superbird settings
+                        </button>
+                    </div>
                     <template id="filter-list-row">
                         <div class="filter-list-row control-row">
                             <input type="checkbox" />
diff --git a/Base/res/ladybird/about-pages/settings/blocking.js b/Base/res/ladybird/about-pages/settings/blocking.js
index ae5f86827..96e7174d6 100644
--- a/Base/res/ladybird/about-pages/settings/blocking.js
+++ b/Base/res/ladybird/about-pages/settings/blocking.js
@@ -15,6 +15,8 @@ const customFilters = document.querySelector("#custom-content-blocker-filters");
 const saveCustomFilters = document.querySelector("#save-custom-content-blocker-filters");
 const customFiltersStatus = document.querySelector("#custom-content-blocker-filters-status");
 const enableContentBlocking = document.querySelector("#enable-content-blocking");
+const engineSummary = document.querySelector("#content-blocker-engine-summary");
+const openSuperbirdBlockingSettings = document.querySelector("#open-superbird-blocking-settings");
 
 const maximumCustomFilterSize = 4 * 1024 * 1024;
 
@@ -79,6 +81,16 @@ function createDisabledSiteRow(site) {
 }
 
 function loadSettings(settings) {
+    if (Object.hasOwn(settings, "superbird") && engineSummary) {
+        const sb = settings.superbird || {};
+        const moduleEnabled = sb.modules?.content_blocking !== false;
+        const mode = sb.options?.content_blocking?.engine_mode ?? "ubo";
+        const uboActive = moduleEnabled && mode !== "default";
+        engineSummary.textContent = uboActive
+            ? "Active engine: uBO-compatible (scriptlets, redirects, procedural hiding)"
+            : "Active engine: Default Ladybird blocker";
+    }
+
     if (Object.hasOwn(settings, "contentBlockers")) {
         const contentBlockers = settings.contentBlockers;
         enableContentBlocking.checked = contentBlockers.enabled;
@@ -125,6 +137,12 @@ enableContentBlocking.addEventListener("change", () => {
     ladybird.sendMessage("setContentBlockerEnabled", enableContentBlocking.checked);
 });
 
+if (openSuperbirdBlockingSettings) {
+    openSuperbirdBlockingSettings.addEventListener("click", () => {
+        location.hash = "#superbird";
+    });
+}
+
 addSubscription.addEventListener("click", () => {
     subscriptionUrl.value = ensureURLHasScheme(subscriptionUrl.value);
     if (!subscriptionUrl.reportValidity() || subscriptionUrl.value.length === 0) {
diff --git a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
index 71a34f329..68cfbcdf1 100644
--- a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
+++ b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
@@ -38,6 +38,7 @@ pub struct ContentBlockerEngine {
     generic_selector_list_rules: GenericSelectorListRules,
     is_ubo_mode: bool,
     missing_resources: std::sync::Arc<std::sync::Mutex<HashSet<String>>>,
+    no_cosmetic_hosts: HashSet<String>,
 }
 
 #[derive(Default)]
@@ -284,6 +285,9 @@ impl GenericSelectorListRules {
 }
 
 fn cosmetic_css_for_url(engine: &ContentBlockerEngine, url: &str, classes: &[&str], ids: &[&str]) -> String {
+    if superbird::is_cosmetic_disabled_for_url(engine, url) {
+        return String::new();
+    }
     let resources = engine.engine.url_cosmetic_resources(url);
     let mut selectors = resources.hide_selectors;
 
@@ -340,6 +344,9 @@ fn has_generic_cosmetic_selectors_for_url(
     classes: &[&str],
     ids: &[&str],
 ) -> bool {
+    if superbird::is_cosmetic_disabled_for_url(engine, url) {
+        return false;
+    }
     let resources = engine.engine.url_cosmetic_resources(url);
     if resources.generichide {
         return false;
@@ -377,6 +384,7 @@ pub extern "C" fn rust_content_blocker_create(rules: ak::Span<'_, u8>) -> *mut C
             generic_selector_list_rules,
             is_ubo_mode: false,
             missing_resources: std::sync::Arc::new(std::sync::Mutex::new(HashSet::new())),
+            no_cosmetic_hosts: HashSet::new(),
         };
         Box::into_raw(Box::new(engine))
     })
diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index b85fc8501..0d3dff56d 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -966,12 +966,14 @@ ErrorOr<bool> Application::load_content_blocker_lists()
         }
     }
 
+    auto site_switches = SuperbirdContentBlocking::site_switch_rules(*m_settings);
     auto bundle = TRY(SuperbirdContentBlocking::build_bundle(
         ubo_mode,
         input_lists.span(),
         custom_filters,
         SuperbirdContentBlocking::trust_custom_filters_enabled(*m_settings),
