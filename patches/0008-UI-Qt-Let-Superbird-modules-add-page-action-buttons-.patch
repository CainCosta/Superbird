From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Superbird <superbird@local>
Date: Tue, 24 Nov 2026 18:42:42 -0600
Subject: [PATCH] UI/Qt: Let Superbird modules add page action buttons to the
 location field


diff --git a/UI/Qt/LocationEdit.cpp b/UI/Qt/LocationEdit.cpp
index 2b45094e..a48fdff3 100644
--- a/UI/Qt/LocationEdit.cpp
+++ b/UI/Qt/LocationEdit.cpp
@@ -675,6 +675,33 @@ QWidget& LocationEdit::translate_button() const
     return *m_translate_button;
 }
 
+void LocationEdit::add_page_action(QAction* action)
+{
+    auto* button = new LocationActionButton(this);
+    button->setToolButtonStyle(Qt::ToolButtonIconOnly);
+    button->setIconSize({ 16, 16 });
+    button->setFixedSize(LOCATION_TRAILING_ACTION_WIDTH, LOCATION_TRAILING_ACTION_HEIGHT);
+    button->setAutoRaise(true);
+    button->setFocusPolicy(Qt::NoFocus);
+    button->setCursor(Qt::ArrowCursor);
+    button->setDefaultAction(action);
+    m_page_action_buttons.append(button);
+
+    auto update = [this, button, action] {
+        button->setVisible(action->isVisible());
+        update_text_margins();
+        update_trailing_item_positions();
+    };
+    connect(action, &QAction::changed, button, update);
+    connect(action, &QObject::destroyed, button, [this, button] {
+        m_page_action_buttons.remove_first_matching([&](auto* candidate) { return candidate == button; });
+        button->deleteLater();
+        update_text_margins();
+        update_trailing_item_positions();
+    });
+    update();
+}
+
 // Like the bookmark star, the translate button is about the page, so it stands aside while the text is being edited.
 void LocationEdit::update_translate_button()
 {
@@ -1189,6 +1216,12 @@ void LocationEdit::update_trailing_item_positions()
     m_translate_button->raise();
     if (!m_translate_button->isHidden())
         items_x -= translate_button_size.width();
+    for (auto* button : m_page_action_buttons) {
+        button->move(items_x - button->width(), (height() - button->height()) / 2);
+        button->raise();
+        if (!button->isHidden())
+            items_x -= button->width();
+    }
 
     auto completion_title_size = m_completion_title->size();
     m_completion_title->move(width() - LOCATION_TRAILING_EDGE_MARGIN - LOCATION_TEXT_PADDING - completion_title_size.width(), (height() - completion_title_size.height()) / 2);
@@ -1233,6 +1266,10 @@ int LocationEdit::trailing_text_margin() const
 
     if (m_translate_button && !m_translate_button->isHidden())
         margin += m_translate_button->width();
+    for (auto* button : m_page_action_buttons) {
+        if (!button->isHidden())
+            margin += button->width();
+    }
     if (m_zoom_indicator_button && !m_zoom_indicator_button->isHidden())
         margin += m_zoom_indicator_button->width() + LOCATION_ZOOM_CHIP_GAP;
     for (auto* chip : { m_location_in_use_chip, m_microphone_in_use_chip }) {
diff --git a/UI/Qt/LocationEdit.h b/UI/Qt/LocationEdit.h
index 1044b973..b9e502b5 100644
--- a/UI/Qt/LocationEdit.h
+++ b/UI/Qt/LocationEdit.h
@@ -61,6 +61,9 @@ public:
     // The translate button stands in the field, before the bookmark star, while the page can be translated.
     void set_translate_action(QAction*);
     QWidget& translate_button() const;
+    // Buttons for other actions about the page (Superbird modules' page actions), before the translate button. Each
+    // shows while its action is visible, and goes away with its action.
+    void add_page_action(QAction*);
     // Shows, while the page uses the user's location or microphone, a chip that says so.
     void set_location_in_use(bool);
     void set_microphone_in_use(bool);
@@ -150,6 +153,7 @@ private:
     qreal m_site_settings_knob_travel { 0 };
     QToolButton* m_trailing_action_button { nullptr };
     QToolButton* m_translate_button { nullptr };
+    Vector<QToolButton*> m_page_action_buttons;
     QAction* m_translate_action { nullptr };
     QGraphicsOpacityEffect* m_translate_opacity { nullptr };
     QVariantAnimation* m_translate_pulse { nullptr };
