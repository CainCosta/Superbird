--- a/Libraries/LibWebView/WebUI/SettingsUI.h
+++ b/Libraries/LibWebView/WebUI/SettingsUI.h
@@ -81,6 +81,8 @@ private:
     void reset_host_setting(JsonValue const&);
     void set_tab_settings(JsonValue const&);
     void set_superbird_module_enabled(JsonValue const&);
+    void set_superbird_module_option(JsonValue const&);
+    void set_superbird_shortcut(JsonValue const&);
     void set_browsing_behavior(JsonValue const&);
     void set_config_variable(JsonValue const&);
 
diff --git a/Services/Hub/ConnectionFromUI.cpp b/Services/Hub/ConnectionFromUI.cpp
index 8d8ff36e9..8da2bbb71 100644
--- a/Services/Hub/ConnectionFromUI.cpp
+++ b/Services/Hub/ConnectionFromUI.cpp
@@ -960,13 +960,14 @@ void ConnectionFromUI::update_settings(u64 change_id, ByteString changes_json)
 }
 
 // The UI compiles Superbird's modules in, and tells this process, which serves about:settings, which ones it has.
-void ConnectionFromUI::register_superbird_module(String id, String name, String description, bool enabled_by_default)
+void ConnectionFromUI::register_superbird_module(String id, String name, String description, bool enabled_by_default, String settings_schema)
 {
     Application::settings().register_superbird_module({
         .id = move(id),
         .name = move(name),
         .description = move(description),
         .enabled_by_default = enabled_by_default,
+        .settings_schema = move(settings_schema),
     });
 }
 
