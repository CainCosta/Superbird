@@ -1696,6 +1713,21 @@ SessionStore& Application::session_store(WebView::IsPrivate is_private)
     return *s_the->m_private_session_store;
 }
 
+#if defined(SUPERBIRD_MODULE_TREE_TABS)
+TreeTabStore& Application::tree_tab_store(WebView::IsPrivate is_private)
+{
+    if (is_private == WebView::IsPrivate::No) {
+        if (!s_the->m_tree_tab_store)
+            s_the->m_tree_tab_store = TreeTabStore::create_transient();
+        return *s_the->m_tree_tab_store;
+    }
+
+    if (!s_the->m_private_tree_tab_store)
+        s_the->m_private_tree_tab_store = TreeTabStore::create_transient();
+    return *s_the->m_private_tree_tab_store;
+}
+#endif
