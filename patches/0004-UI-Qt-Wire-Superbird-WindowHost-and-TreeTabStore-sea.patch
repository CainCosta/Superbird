+        if (auto* source_view = RemoteView::find(*source_view_id))
+            window->superbird().on_pending_opener(window->tab_for_view(*source_view));
+    }
     window->new_tab_from_url(url, activate_tab, BrowserWindow::TabLocation::after_current_tab());
 }
 
@@ -2486,6 +2527,10 @@ void Application::open_navigation_in_new_tab(Web::HTML::PreparedNavigationDescri
