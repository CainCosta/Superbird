From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:10:31 -0600
Subject: [PATCH] LibWeb: support uBO-compatible redirects, removeparam, CSP
 injection, and WebSocket blocking


diff --git a/Libraries/LibWeb/ContentBlocker/Rust/cbindgen.toml b/Libraries/LibWeb/ContentBlocker/Rust/cbindgen.toml
index cec7fa6ca..3eab2f454 100644
--- a/Libraries/LibWeb/ContentBlocker/Rust/cbindgen.toml
+++ b/Libraries/LibWeb/ContentBlocker/Rust/cbindgen.toml
@@ -21,7 +21,7 @@ parse_deps = false
 all_features = false
 
 [export]
-include = ["ContentBlockerString"]
+include = ["ContentBlockerString", "ContentBlockerMatchResult"]
 # Opaque to C++, which names it by a void pointer (see below).
 exclude = ["ContentBlockerEngine"]
 
diff --git a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
index 5e0a3187d..91bde90b0 100644
--- a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
+++ b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
@@ -25,6 +25,14 @@ pub struct ContentBlockerString {
     length: usize,
 }
 
+#[repr(C)]
+pub struct ContentBlockerMatchResult {
+    matched: bool,
+    important: bool,
+    redirect_data_url: ContentBlockerString,
+    rewritten_url: ContentBlockerString,
+}
+
 pub struct ContentBlockerEngine {
     engine: adblock::engine::Engine,
     generic_selector_list_rules: GenericSelectorListRules,
@@ -404,6 +412,73 @@ pub extern "C" fn rust_content_blocker_missing_resources(
     })
 }
 
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_check_request(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+    source_url: ak::Span<'_, u8>,
+    request_type: ak::Span<'_, u8>,
+    method: ak::Span<'_, u8>,
+) -> ContentBlockerMatchResult {
+    abort_on_panic(|| {
+        let empty = || ContentBlockerMatchResult {
+            matched: false,
+            important: false,
+            redirect_data_url: string_to_ffi(String::new()),
+            rewritten_url: string_to_ffi(String::new()),
+        };
+        let Some(engine) = engine else {
+            return empty();
+        };
+        let Some(url) = as_str(url) else {
+            return empty();
+        };
+        let Some(source_url) = as_str(source_url) else {
+            return empty();
+        };
+        let Some(request_type) = as_str(request_type) else {
+            return empty();
+        };
+        let method = as_str(method).unwrap_or("");
+        let outcome = superbird::check_network_request(engine, url, source_url, request_type, method);
+        ContentBlockerMatchResult {
+            matched: outcome.matched,
+            important: outcome.important,
+            redirect_data_url: string_to_ffi(outcome.redirect_data_url),
+            rewritten_url: string_to_ffi(outcome.rewritten_url),
+        }
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_csp_directives(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+    source_url: ak::Span<'_, u8>,
+    request_type: ak::Span<'_, u8>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return string_to_ffi(String::new());
+        };
+        let Some(url) = as_str(url) else {
+            return string_to_ffi(String::new());
+        };
+        let Some(source_url) = as_str(source_url) else {
+            return string_to_ffi(String::new());
+        };
+        let Some(request_type) = as_str(request_type) else {
+            return string_to_ffi(String::new());
+        };
+        string_to_ffi(superbird::csp_directives_for_url(
+            engine,
+            url,
+            source_url,
+            request_type,
+        ))
+    })
+}
+
 /// # Safety
 /// - `engine` must be null or a valid pointer returned by `rust_content_blocker_create`
 #[unsafe(no_mangle)]
