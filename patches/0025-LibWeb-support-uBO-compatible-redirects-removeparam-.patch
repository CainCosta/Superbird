+static Optional<String> take_rust_optional_string(ContentBlocking::FFI::ContentBlockerString rust_string)
+{
+    if (!rust_string.data)
+        return {};
+
+    ArmedScopeGuard free_string = [&] {
+        ContentBlocking::FFI::rust_content_blocker_free_string(rust_string.data, rust_string.length);
+    };
+
+    auto maybe_string = String::from_utf8({ reinterpret_cast<char const*>(rust_string.data), rust_string.length });
+    if (maybe_string.is_error() || maybe_string.value().is_empty())
+        return {};
+    return maybe_string.release_value();
+}
+
 static Utf16String take_rust_utf16_string(ContentBlocking::FFI::ContentBlockerString rust_string)
 {
     if (!rust_string.data)
@@ -210,6 +225,67 @@ bool ContentBlocker::is_filtered(URL::URL const& url, URL::URL const& source_url
         request_type.bytes());
 }
 
+ContentBlocker::MatchResult ContentBlocker::check_request(URL::URL const& url, URL::URL const& source_url, Optional<Fetch::Infrastructure::Request::Destination> const& destination, Optional<Fetch::Infrastructure::Request::InitiatorType> const& initiator_type, Fetch::Infrastructure::Request::Mode mode, StringView method) const
+{
+    return check_request(url, source_url_for_matching(source_url), resource_type_from_fetch_metadata(destination, initiator_type, mode), method);
+}
+
+ContentBlocker::MatchResult ContentBlocker::check_request(URL::URL const& url, URL::URL const& source_url, ResourceType resource_type, StringView method) const
+{
+    if (!has_rules() || url.scheme() == "data"sv)
+        return {};
+
+    auto url_string = serialized_url_for_matching(url);
+    auto normalized_source_url = source_url_for_matching(source_url);
+    auto source_url_string = serialized_url_for_matching(normalized_source_url);
+    auto request_type = resource_type_to_adblock_request_type(resource_type);
+
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return {};
+
+    auto raw = ContentBlocking::FFI::rust_content_blocker_check_request(
+        engine,
+        url_string.bytes(),
+        source_url_string.bytes(),
+        request_type.bytes(),
+        method.bytes());
+
+    MatchResult result;
+    result.matched = raw.matched;
+    result.important = raw.important;
+    result.redirect_data_url = take_rust_optional_string(raw.redirect_data_url);
+    auto rewritten = take_rust_optional_string(raw.rewritten_url);
+    if (rewritten.has_value() && (url.scheme() == "http"sv || url.scheme() == "https"sv))
+        result.rewritten_url = move(rewritten);
+    return result;
+}
+
+Optional<String> ContentBlocker::csp_directives_for_url(URL::URL const& url, URL::URL const& source_url, ResourceType resource_type) const
+{
+    if (!has_rules() || !is_ubo_mode())
+        return {};
+    if (url.scheme() != "http"sv && url.scheme() != "https"sv)
+        return {};
+
+    auto url_string = serialized_url_for_matching(url);
+    auto normalized_source_url = source_url_for_matching(source_url);
+    auto source_url_string = serialized_url_for_matching(normalized_source_url);
+    auto request_type = resource_type_to_adblock_request_type(resource_type);
+
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return {};
+
+    return take_rust_optional_string(ContentBlocking::FFI::rust_content_blocker_csp_directives(
+        engine,
+        url_string.bytes(),
+        source_url_string.bytes(),
+        request_type.bytes()));
+}
+
 Utf16String ContentBlocker::cosmetic_style_sheet_for_url(URL::URL const& url) const
 {
     return cosmetic_style_sheet_for_url(url, {}, {});
