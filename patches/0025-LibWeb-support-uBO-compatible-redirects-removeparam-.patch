         // 9. Set responsePolicyContainer to the result of creating a policy container from a fetch response given response and request's reserved client.
         state_holder->response_policy_container = create_a_policy_container_from_a_fetch_response(*state_holder->response, state_holder->reserved_client);
 
+        if (ContentBlocker::the().has_rules() && ContentBlocker::the().is_ubo_mode()
+            && !state_holder->response->is_network_error() && state_holder->response->url().has_value()) {
+            auto const& response_url = *state_holder->response->url();
+            Optional<URL::URL> top_level_url;
+            if (state_holder->navigable->is_top_level_traversable())
+                top_level_url = response_url;
+            else if (state_holder->reserved_client && state_holder->reserved_client->top_level_creation_url.has_value())
