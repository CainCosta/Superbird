@@ -3082,6 +3117,46 @@ GC::Ref<PendingResponse> nonstandard_resource_loader_file_or_http_network_fetch(
 
     auto pending_response = PendingResponse::create(fetch_params);
 
+    if (ContentBlocker::the().has_rules() && ContentBlocker::the().is_ubo_mode()) {
+        auto page = load_request.page();
+        if (!page || page->content_blocking_enabled_for_url(load_request.top_level_creation_url())) {
+            auto source_url = load_request.source_url().value_or(request->current_url());
+            auto match = ContentBlocker::the().check_request(
+                request->current_url(),
+                source_url,
+                request->destination(),
+                request->initiator_type(),
+                request->mode(),
+                request->method());
+            if (match.redirect_data_url.has_value()) {
+                if (auto redirect_url = URL::Parser::basic_parse(*match.redirect_data_url); redirect_url.has_value()) {
+                    if (auto data_url_struct = Infrastructure::process_data_url(*redirect_url); !data_url_struct.is_error()) {
+                        auto response = Infrastructure::Response::create();
+                        response->set_status(200);
+                        response->set_status_message("OK"sv);
+                        response->set_url_list(request->url_list());
+                        response->header_list()->append(HTTP::Header::isomorphic_encode("Content-Type"sv, data_url_struct.value().mime_type.serialized()));
+                        if (request->mode() == Infrastructure::Request::Mode::CORS) {
+                            if (include_credentials == HTTP::Cookie::IncludeCredentials::Yes) {
+                                if (auto const* origin = request->origin().get_pointer<URL::Origin>()) {
+                                    response->header_list()->append(HTTP::Header::isomorphic_encode("Access-Control-Allow-Origin"sv, origin->serialize()));
+                                    response->header_list()->append(HTTP::Header::isomorphic_encode("Access-Control-Allow-Credentials"sv, "true"sv));
+                                }
+                            } else {
+                                response->header_list()->append(HTTP::Header::isomorphic_encode("Access-Control-Allow-Origin"sv, "*"sv));
+                            }
+                        }
+                        response->set_body(Infrastructure::byte_sequence_as_response_body(data_url_struct.value().body));
+                        if (page)
+                            page->client().page_did_block_resource(request->current_url(), "Redirect"sv);
+                        pending_response->resolve(response);
+                        return pending_response;
+                    }
+                }
+            }
+        }
+    }
+
     if constexpr (WEB_FETCH_DEBUG) {
         dbgln("Fetch: Invoking ResourceLoader");
         log_load_request(load_request);
