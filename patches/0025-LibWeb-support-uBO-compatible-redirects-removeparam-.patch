+                URL::URL source_url = response_url;
+                auto resource_type = ContentBlocker::ResourceType::Document;
+                if (!state_holder->navigable->is_top_level_traversable()) {
+                    resource_type = ContentBlocker::ResourceType::Subdocument;
+                    if (auto* parent = as_if<LocalNavigable>(state_holder->navigable->parent().ptr()); parent && parent->active_document())
+                        source_url = parent->active_document()->url();
+                    else if (top_level_url.has_value())
+                        source_url = *top_level_url;
+                }
+                if (auto csp_header = ContentBlocker::the().csp_directives_for_url(response_url, source_url, resource_type); csp_header.has_value()) {
