From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 07:27:25 -0600
Subject: [PATCH] UI/Qt: Float the tree sidebar's new tab button under the last
 tab

With Superbird Tree Tabs, the tree is only as tall as its rows, so the
new tab button sits right under the last one instead of at the bottom of
the sidebar, with its icon centered under the indented rows.

diff --git a/UI/Qt/TabBar.cpp b/UI/Qt/TabBar.cpp
index 9fd3da8d..8a309226 100644
--- a/UI/Qt/TabBar.cpp
+++ b/UI/Qt/TabBar.cpp
@@ -544,6 +544,9 @@ static QRect collapsed_vertical_tab_shape_rect(QRect const& rect)
     return rect.adjusted(COLLAPSED_VERTICAL_TAB_CARD_INSET, TAB_CARD_SHAPE_TOP_INSET, -COLLAPSED_VERTICAL_TAB_CARD_INSET, -TAB_CARD_SHAPE_BOTTOM_INSET);
 }
 
+// Superbird Tree Tabs: the sidebar's new tab button centers its icon under the tree, whose rows are indented.
+static constexpr char const* SUPERBIRD_CENTERED_ICON_PROPERTY = "superbirdCenteredIcon";
+
 class NewTabButton final : public QToolButton {
 public:
     AK_ALLOC_WITH_KMALLOC;
@@ -613,7 +616,7 @@ private:
         // NB: The buttons on the strip draw their icons at their own sizes.
         auto icon_size = is_horizontal_new_tab_button ? iconSize() : QSize(TAB_ICON_SIZE, TAB_ICON_SIZE);
         QRect icon_rect {
-            expanded ? contents_rect.left() - ((icon_size.width() - TAB_ICON_SIZE) / 2) : (is_horizontal_new_tab_button ? (width() - icon_size.width()) / 2 : rect().center().x() - (icon_size.width() / 2)),
+            expanded ? (property(SUPERBIRD_CENTERED_ICON_PROPERTY).toBool() ? qRound(shape_rect.center().x() - (icon_size.width() / 2.0)) : contents_rect.left() - ((icon_size.width() - TAB_ICON_SIZE) / 2)) : (is_horizontal_new_tab_button ? (width() - icon_size.width()) / 2 : rect().center().x() - (icon_size.width() / 2)),
             contents_rect.top() + ((contents_rect.height() - icon_size.height()) / 2),
             icon_size.width(),
             icon_size.height(),
@@ -5085,9 +5088,13 @@ void TabWidget::rebuild_layout_for_vertical_tabs()
         m_tab_bar->hide();
         m_tree_tabs_widget->setParent(m_vertical_tab_bar_column);
         m_tree_tabs_widget->show();
-        m_vertical_tab_bar_column_layout->addWidget(m_tree_tabs_widget, 1);
+        // NB: The tree is only as tall as its rows, so the new tab button sits under the last one, its icon centered.
+        m_vertical_tab_bar_column_layout->addWidget(m_tree_tabs_widget);
         m_vertical_tab_bar_column_layout->addWidget(m_new_tab_button, 0, vertical_tabs_are_on_right() ? Qt::AlignRight : Qt::AlignLeft);
+        m_vertical_tab_bar_column_layout->addStretch(1);
+        m_new_tab_button->setProperty(SUPERBIRD_CENTERED_ICON_PROPERTY, true);
     } else {
+        m_new_tab_button->setProperty(SUPERBIRD_CENTERED_ICON_PROPERTY, false);
         if (m_tree_tabs_widget)
             m_tree_tabs_widget->hide();
         m_tab_bar->show();
