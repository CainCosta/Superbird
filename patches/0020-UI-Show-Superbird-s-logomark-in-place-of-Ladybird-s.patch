index eb0cdd8e..ae8f8e69 100644
--- a/Base/res/ladybird/about-pages/version.html
+++ b/Base/res/ladybird/about-pages/version.html
@@ -18,21 +18,24 @@
 
             .logomark {
                 width: 168px;
-                height: 141px;
+                height: 134px;
             }
 
-            .logomark path {
-                stroke: var(--brand-mark);
-                stroke-width: 0.95;
+            .logomark .bird {
+                fill: var(--brand-mark);
+            }
+
+            .logomark .star {
+                fill: #ff3b4e;
             }
 
             :root {
-                --brand-mark: #6a39db;
+                --brand-mark: #252836;
             }
 
             @media (prefers-color-scheme: dark) {
                 :root {
-                    --brand-mark: #b496ff;
+                    --brand-mark: #f2f3f7;
