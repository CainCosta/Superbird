+    QObject::connect(m_context_menu, &QMenu::aboutToShow, this, [this, new_tab_action, new_child_tab_action, tree_branch_separator, toggle_branch_action, unload_branch_action, bookmark_branch_action, move_branch_to_new_window_action, close_branch_action, close_following_tabs_action, mute_tab_action, move_to_new_window_action]() {
         auto is_horizontal = m_window->tab_widget().tab_bar()->tab_layout() == TabLayout::Horizontal;
