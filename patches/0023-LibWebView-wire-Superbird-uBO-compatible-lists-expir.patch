+            });
         m_content_blocker_list_update_timer->start();
-        start_content_blocker_list_update(ContentBlockerListUpdateTrigger::Automatic);
+        if (!m_browser_options.headless_mode.has_value() && !m_browser_options.webdriver_browser_endpoint.has_value())
+            start_content_blocker_list_update(ContentBlockerListUpdateTrigger::Automatic);
     }
 
 #if defined(LADYBIRD_HAS_UPDATE_CHECK)
@@ -874,6 +884,11 @@ ByteString Application::content_blocker_list_path(StringView identifier) const
     return LexicalPath::join(m_content_blocker_lists_directory, ByteString::formatted("{}.txt", identifier)).string();
 }
 
+ByteString Application::content_blocker_resources_path() const
+{
+    return LexicalPath::join(m_content_blocker_resources_directory, "ubo-resources.json"sv).string();
+}
+
 Optional<UnixDateTime> Application::content_blocker_list_last_updated_at(StringView identifier) const
 {
     if (auto file_status = Core::File::stat(content_blocker_list_path(identifier)); !file_status.is_error())
@@ -885,7 +900,10 @@ void Application::rebuild_content_blocker_list_paths()
 {
     m_browser_options.content_blocker_list_paths = m_explicit_content_blocker_list_paths;
 
+    bool ubo_mode = SuperbirdContentBlocking::is_ubo_mode_enabled(*m_settings);
     for (auto const& list : m_settings->content_blocker_lists()) {
+        if (!ubo_mode && SuperbirdContentBlocking::is_ubo_only_list_identifier(list.identifier))
+            continue;
         auto path = content_blocker_list_path(list.identifier);
         if (list.enabled && FileSystem::is_regular_file(path))
             m_browser_options.content_blocker_list_paths.append(move(path));
@@ -895,40 +913,81 @@ void Application::rebuild_content_blocker_list_paths()
 ErrorOr<bool> Application::load_content_blocker_lists()
 {
     auto custom_filters = m_settings->custom_content_blocker_filters();
-    if (m_browser_options.content_blocker_list_paths.is_empty() && custom_filters.is_empty()) {
+    bool ubo_mode = SuperbirdContentBlocking::is_ubo_mode_enabled(*m_settings);
+
+    Vector<SuperbirdContentBlocking::BundleInputList> input_lists;
+
+    auto append_list_from_file = [&](String id, ByteString const& path, bool trusted) {
+        auto file_or_error = Core::File::open(path, Core::File::OpenMode::Read);
+        if (file_or_error.is_error()) {
+            warnln("Unable to open content blocker list {}: {}", path, file_or_error.error());
+            return;
+        }
+        auto size_or_error = file_or_error.value()->size();
+        if (size_or_error.is_error() || size_or_error.value() > maximum_content_blocker_list_size) {
+            warnln("Skipping content blocker list {} (invalid or oversized)", path);
+            return;
+        }
+        auto contents_or_error = file_or_error.value()->read_until_eof();
+        if (contents_or_error.is_error()) {
+            warnln("Unable to read content blocker list {}: {}", path, contents_or_error.error());
+            return;
+        }
+        input_lists.append({
+            .id = move(id),
+            .trusted = trusted,
+            .is_hosts_format = false,
+            .contents = contents_or_error.release_value(),
+        });
+    };
+
+    for (size_t i = 0; i < m_explicit_content_blocker_list_paths.size(); ++i)
+        append_list_from_file(MUST(String::formatted("explicit-{}", i)), m_explicit_content_blocker_list_paths[i], false);
+
+    for (auto const& list : m_settings->content_blocker_lists()) {
+        if (!list.enabled)
+            continue;
+        if (!ubo_mode && SuperbirdContentBlocking::is_ubo_only_list_identifier(list.identifier))
+            continue;
+        auto path = content_blocker_list_path(list.identifier);
+        if (!FileSystem::is_regular_file(path))
+            continue;
+        append_list_from_file(list.identifier, path, SuperbirdContentBlocking::is_trusted_list_identifier(list.identifier));
+    }
+
+    ByteBuffer resources_json;
+    if (ubo_mode) {
+        auto resources_path = content_blocker_resources_path();
+        if (FileSystem::is_regular_file(resources_path)) {
+            if (auto file_or_error = Core::File::open(resources_path, Core::File::OpenMode::Read); !file_or_error.is_error()) {
+                auto size_or_error = file_or_error.value()->size();
+                if (!size_or_error.is_error() && size_or_error.value() <= maximum_content_blocker_list_size) {
+                    if (auto contents = file_or_error.value()->read_until_eof(); !contents.is_error())
+                        resources_json = contents.release_value();
+                }
+            }
+        }
+    }
+
+    auto bundle = TRY(SuperbirdContentBlocking::build_bundle(
+        ubo_mode,
+        input_lists.span(),
+        custom_filters,
+        SuperbirdContentBlocking::trust_custom_filters_enabled(*m_settings),
+        resources_json.bytes()));
+
+    if (bundle.is_empty()) {
         if (m_content_blocker_list_buffer.has_value() && m_content_blocker_list_buffer->size() == 0)
             return false;
         m_content_blocker_list_buffer = TRY(Core::AnonymousBuffer::create_with_size(0));
         return true;
     }
 
-    Checked<size_t> total_size = 0;
-    for (auto const& path : m_browser_options.content_blocker_list_paths) {
-        auto file = TRY(Core::File::open(path, Core::File::OpenMode::Read));
-        total_size += TRY(file->size());
-        total_size += 1;
-    }
-    total_size += custom_filters.bytes().size();
-    total_size += 1;
-
-    if (total_size.has_overflow() || total_size.value() > maximum_combined_content_blocker_list_size)
+    if (bundle.size() > maximum_combined_content_blocker_list_size)
         return Error::from_string_literal("Content blocker lists are too large");
 
-    auto blocker_list_buffer = TRY(Core::AnonymousBuffer::create_with_size(total_size.value()));
-    auto bytes = Bytes { blocker_list_buffer.data<u8>(), blocker_list_buffer.size() };
-    size_t offset = 0;
-
-    for (auto const& path : m_browser_options.content_blocker_list_paths) {
-        auto file = TRY(Core::File::open(path, Core::File::OpenMode::Read));
-        auto file_size = TRY(file->size());
-        TRY(file->read_until_filled(bytes.slice(offset, file_size)));
-        offset += file_size;
-        bytes[offset++] = '\n';
-    }
-    custom_filters.bytes().copy_to(bytes.slice(offset));
-    offset += custom_filters.bytes().size();
-    bytes[offset++] = '\n';
-    VERIFY(offset == bytes.size());
+    auto blocker_list_buffer = TRY(Core::AnonymousBuffer::create_with_size(bundle.size()));
+    bundle.bytes().copy_to({ blocker_list_buffer.data<u8>(), blocker_list_buffer.size() });
 
     if (m_content_blocker_list_buffer.has_value() && m_content_blocker_list_buffer->bytes() == blocker_list_buffer.bytes())
         return false;
@@ -944,17 +1003,50 @@ void Application::start_content_blocker_list_update(ContentBlockerListUpdateTrig
     if (content_blocker_list_update_in_progress() && !requested_identifier.has_value())
         return;
 
+    bool ubo_mode = SuperbirdContentBlocking::is_ubo_mode_enabled(*m_settings);
     for (auto const& list : m_settings->content_blocker_lists()) {
         if (!list.enabled || !list.url.has_value() || (requested_identifier.has_value() && list.identifier != *requested_identifier))
             continue;
+        if (trigger == ContentBlockerListUpdateTrigger::Automatic && !ubo_mode && SuperbirdContentBlocking::is_ubo_only_list_identifier(list.identifier))
+            continue;
         if (m_active_content_blocker_list_update.has_value() && m_active_content_blocker_list_update->identifier == list.identifier)
             continue;
         if (any_of(m_pending_content_blocker_list_updates, [&](auto const& update) { return update.identifier == list.identifier; }))
             continue;
+        auto path = content_blocker_list_path(list.identifier);
         auto updated_at = content_blocker_list_last_updated_at(list.identifier);
-        if (trigger == ContentBlockerListUpdateTrigger::Automatic && updated_at.has_value() && UnixDateTime::now() - *updated_at < AK::Duration::from_seconds(24 * 60 * 60))
+        auto expiry = AK::Duration::from_seconds(SuperbirdContentBlocking::list_expiry_seconds_for_file(path, list.identifier));
+        if (trigger == ContentBlockerListUpdateTrigger::Automatic && updated_at.has_value() && UnixDateTime::now() - *updated_at < expiry)
             continue;
-        m_pending_content_blocker_list_updates.append({ list.identifier, list.name, *list.url, content_blocker_list_path(list.identifier), trigger });
+        m_pending_content_blocker_list_updates.append({ list.identifier, list.name, *list.url, move(path), trigger });
+    }
+
+    if (ubo_mode && (!requested_identifier.has_value() || *requested_identifier == SuperbirdContentBlocking::resources_update_identifier)) {
+        if (auto resources_url = SuperbirdContentBlocking::ubo_resources_url(); resources_url.has_value()) {
+            bool already_active = m_active_content_blocker_list_update.has_value()
+                && m_active_content_blocker_list_update->identifier == SuperbirdContentBlocking::resources_update_identifier;
+            bool already_pending = any_of(m_pending_content_blocker_list_updates, [&](auto const& update) {
+                return update.identifier == SuperbirdContentBlocking::resources_update_identifier;
+            });
+            if (!already_active && !already_pending) {
+                auto resources_path = content_blocker_resources_path();
+                Optional<UnixDateTime> updated_at;
+                if (auto file_status = Core::File::stat(resources_path); !file_status.is_error())
+                    updated_at = UnixDateTime::from_seconds_since_epoch(file_status.value().st_mtime);
+                bool stale_or_missing = !updated_at.has_value()
+                    || trigger == ContentBlockerListUpdateTrigger::UserInitiated
+                    || UnixDateTime::now() - *updated_at >= AK::Duration::from_seconds(SuperbirdContentBlocking::resources_expiry_seconds);
+                if (stale_or_missing) {
+                    m_pending_content_blocker_list_updates.append({
+                        MUST(String::from_utf8(SuperbirdContentBlocking::resources_update_identifier)),
+                        "uBO-compatible scriptlet resources"_string,
+                        *resources_url,
+                        move(resources_path),
+                        trigger,
+                    });
+                }
+            }
+        }
     }
 
     if (!m_active_content_blocker_list_update.has_value())
@@ -964,6 +1056,8 @@ void Application::start_content_blocker_list_update(ContentBlockerListUpdateTrig
 void Application::start_next_content_blocker_list_update()
 {
     m_pending_content_blocker_list_updates.remove_all_matching([&](auto const& update) {
+        if (update.identifier == SuperbirdContentBlocking::resources_update_identifier)
+            return !SuperbirdContentBlocking::is_ubo_mode_enabled(*m_settings);
         auto list = m_settings->content_blocker_list(update.identifier);
         return !list.has_value() || !list->enabled;
     });
@@ -1097,7 +1191,7 @@ void Application::finish_current_content_blocker_list_update()
 
 ErrorOr<void> Application::save_content_blocker_list(ByteString const& path, ReadonlyBytes contents)
 {
-    TRY(Core::Directory::create(m_content_blocker_lists_directory, Core::Directory::CreateDirectories::Yes));
+    TRY(Core::Directory::create(LexicalPath::dirname(path), Core::Directory::CreateDirectories::Yes));
     auto temporary_path = ByteString::formatted("{}.tmp", path);
     {
         auto file = TRY(Core::File::open(temporary_path, Core::File::OpenMode::Write));
@@ -3256,6 +3350,17 @@ void Application::content_blocker_settings_changed(Badge<ApplicationSettingsObse
     apply_content_blocker_settings();
 }
 
+void Application::superbird_settings_changed(Badge<ApplicationSettingsObserver>)
+{
+    apply_content_blocker_settings();
+    if (m_browser_options.enable_content_blocker == EnableContentBlocker::Yes
+        && !m_browser_options.headless_mode.has_value()
+        && !m_browser_options.webdriver_browser_endpoint.has_value()
+        && SuperbirdContentBlocking::is_ubo_mode_enabled(*m_settings)) {
+        start_content_blocker_list_update(ContentBlockerListUpdateTrigger::Automatic);
+    }
+}
+
 void Application::apply_content_blocker_settings()
 {
     rebuild_content_blocker_list_paths();
