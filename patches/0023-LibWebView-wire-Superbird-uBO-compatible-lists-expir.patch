+TEST_CASE(superbird_content_blocking_mode_switch_and_trust_defaults)
+{
+    remove_settings_file();
+    auto settings = WebView::Settings::create(settings_path());
+
+    EXPECT(settings.content_blocker_enabled());
+    EXPECT(WebView::SuperbirdContentBlocking::is_ubo_mode_enabled(settings));
+    EXPECT(!WebView::SuperbirdContentBlocking::trust_custom_filters_enabled(settings));
+    EXPECT(!WebView::SuperbirdContentBlocking::logger_enabled(settings));
+
+    settings.set_superbird_module_option("content_blocking"_string, "engine_mode"_string, "default"_string);
+    EXPECT(!WebView::SuperbirdContentBlocking::is_ubo_mode_enabled(settings));
+
+    settings.set_superbird_module_option("content_blocking"_string, "engine_mode"_string, "ubo"_string);
+    EXPECT(WebView::SuperbirdContentBlocking::is_ubo_mode_enabled(settings));
+
+    settings.set_superbird_module_enabled("content_blocking"_string, false);
+    EXPECT(!WebView::SuperbirdContentBlocking::is_ubo_mode_enabled(settings));
+
+    settings.set_superbird_module_enabled("content_blocking"_string, true);
+    settings.set_superbird_module_option("content_blocking"_string, "trust_custom_filters"_string, "true"_string);
+    EXPECT(WebView::SuperbirdContentBlocking::trust_custom_filters_enabled(settings));
+
+    remove_settings_file();
+}
