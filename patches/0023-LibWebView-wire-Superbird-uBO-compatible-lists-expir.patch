From: Caio <16298860+CainCosta@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:54:25 -0600
Subject: [PATCH] LibWebView: wire Superbird uBO-compatible lists, expiry,
 bundle, and mode switch


diff --git a/Base/res/ladybird/about-pages/welcome.js b/Base/res/ladybird/about-pages/welcome.js
index 5d36dc4b..c3fafd3c 100644
--- a/Base/res/ladybird/about-pages/welcome.js
+++ b/Base/res/ladybird/about-pages/welcome.js
@@ -179,7 +179,17 @@ enableContentBlocking.addEventListener("change", () => {
 
     // Enable the lists before the content blocker, which then downloads every enabled list.
     if (enableContentBlocking.checked) {
-        for (const identifier of ["easyList", "easyPrivacy"])
+        for (const identifier of [
+            "easyList",
+            "easyPrivacy",
+            "uboFilters",
+            "uboBadware",
+            "uboPrivacy",
+            "uboUnbreak",
+            "uboQuickFixes",
+            "peterLowe",
+            "urlhaus",
+        ])
             ladybird.sendMessage("setContentBlockerListEnabled", { identifier, enabled: true });
     }
 
diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 72ac501a..4de681f6 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -71,6 +71,7 @@
 #include <LibWebView/SiteCompatibility.h>
