Subject: [PATCH] LibWeb+LibWebView: add binary snapshot cache, cosmetic
 prefilter, and opt-in filter logger


diff --git a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
index 68cfbcdf..2c5f5113 100644
--- a/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
+++ b/Libraries/LibWeb/ContentBlocker/Rust/src/lib.rs
@@ -37,8 +37,11 @@ pub struct ContentBlockerEngine {
     engine: adblock::engine::Engine,
     generic_selector_list_rules: GenericSelectorListRules,
     is_ubo_mode: bool,
+    logger_enabled: bool,
     missing_resources: std::sync::Arc<std::sync::Mutex<HashSet<String>>>,
     no_cosmetic_hosts: HashSet<String>,
+    filter_log: std::sync::Mutex<std::collections::VecDeque<superbird::FilterLogEntry>>,
+    stats: superbird::EngineStats,
 }
 
 #[derive(Default)]
@@ -155,7 +158,11 @@ impl GenericSelectorListRules {
     fn add_rules(&mut self, rules: &str) {
         for line in rules.lines() {
             let trimmed_line = line.trim();
-            if trimmed_line.is_empty() || trimmed_line.starts_with('!') || trimmed_line.starts_with('[') {
+            if trimmed_line.is_empty()
+                || trimmed_line.starts_with('!')
+                || trimmed_line.starts_with('[')
+                || (!trimmed_line.contains("##") && !trimmed_line.contains("#?#"))
+            {
                 continue;
             }
 
@@ -383,8 +390,11 @@ pub extern "C" fn rust_content_blocker_create(rules: ak::Span<'_, u8>) -> *mut C
             engine,
             generic_selector_list_rules,
             is_ubo_mode: false,
+            logger_enabled: false,
             missing_resources: std::sync::Arc::new(std::sync::Mutex::new(HashSet::new())),
             no_cosmetic_hosts: HashSet::new(),
+            filter_log: std::sync::Mutex::new(std::collections::VecDeque::new()),
+            stats: superbird::EngineStats::default(),
         };
         Box::into_raw(Box::new(engine))
     })
@@ -423,6 +433,30 @@ pub extern "C" fn rust_content_blocker_missing_resources(
     })
 }
 
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_filter_log(
+    engine: Option<&ContentBlockerEngine>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return string_to_ffi("[]".to_string());
+        };
+        string_to_ffi(superbird::filter_log_json(engine))
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_stats(
+    engine: Option<&ContentBlockerEngine>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return string_to_ffi("{}".to_string());
+        };
+        string_to_ffi(superbird::engine_stats_json(engine))
+    })
+}
+
 #[unsafe(no_mangle)]
 pub extern "C" fn rust_content_blocker_check_request(
     engine: Option<&ContentBlockerEngine>,
