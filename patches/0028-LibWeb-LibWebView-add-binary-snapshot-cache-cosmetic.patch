diff --git a/Libraries/LibWeb/Loader/ContentBlocker.cpp b/Libraries/LibWeb/Loader/ContentBlocker.cpp
index 4d578fd1..47967c64 100644
--- a/Libraries/LibWeb/Loader/ContentBlocker.cpp
+++ b/Libraries/LibWeb/Loader/ContentBlocker.cpp
@@ -372,6 +372,24 @@ Utf16String ContentBlocker::missing_resources_json() const
     return take_rust_utf16_string(ContentBlocking::FFI::rust_content_blocker_missing_resources(engine));
 }
 
+Utf16String ContentBlocker::filter_log_json() const
+{
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return "[]"_utf16;
+    return take_rust_utf16_string(ContentBlocking::FFI::rust_content_blocker_filter_log(engine));
+}
+
+Utf16String ContentBlocker::stats_json() const
+{
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return "{}"_utf16;
+    return take_rust_utf16_string(ContentBlocking::FFI::rust_content_blocker_stats(engine));
+}
