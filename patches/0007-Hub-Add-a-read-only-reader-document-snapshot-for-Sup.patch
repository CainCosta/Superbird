diff --git a/UI/Qt/RemoteView.cpp b/UI/Qt/RemoteView.cpp
index ca346e15..5ca432b3 100644
--- a/UI/Qt/RemoteView.cpp
+++ b/UI/Qt/RemoteView.cpp
@@ -335,6 +335,15 @@ NonnullRefPtr<Core::Promise<String>> RemoteView::request_page_dumps()
     return promise;
 }
 
+NonnullRefPtr<Core::Promise<String>> RemoteView::request_reader_document()
+{
+    auto promise = Core::Promise<String>::construct();
+    auto request_id = m_next_request_id++;
+    m_pending_page_dumps.set(request_id, promise);
+    HubConnection::the().async_view_request_reader_document(view_id(), request_id);
+    return promise;
+}
+
 void RemoteView::did_get_page_dumps(u64 request_id, Optional<String> dumps)
 {
     auto promise = m_pending_page_dumps.take(request_id);
