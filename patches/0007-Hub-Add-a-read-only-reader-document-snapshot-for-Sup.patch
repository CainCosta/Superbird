diff --git a/Services/WebContent/ConnectionFromClient.cpp b/Services/WebContent/ConnectionFromClient.cpp
index f9b38875..00029b27 100644
--- a/Services/WebContent/ConnectionFromClient.cpp
+++ b/Services/WebContent/ConnectionFromClient.cpp
@@ -2958,6 +2958,13 @@ void ConnectionFromClient::request_internal_page_info(Web::PageId page_id, WebVi
         append_display_list(page->page(), builder);
     }
 
+    if (has_flag(type, WebView::PageInfoType::DocumentHTML)) {
+        if (auto document = page->page().local_traversable()->active_document(); document && document->document_element()) {
+            if (auto html = document->document_element()->outer_html(); !html.is_error())
+                builder.append(html.value().to_utf8());
+        }
+    }
+
     if (has_flag(type, WebView::PageInfoType::AccessibilityTree)) {
         if (!builder.is_empty())
             builder.append("\n"sv);
diff --git a/UI/Qt/HubConnection.cpp b/UI/Qt/HubConnection.cpp
index 8b59c058..478b8032 100644
--- a/UI/Qt/HubConnection.cpp
+++ b/UI/Qt/HubConnection.cpp
@@ -743,6 +743,13 @@ void HubConnection::view_page_dumps(u64 view_id, u64 request_id, Optional<String
         view->did_get_page_dumps(request_id, move(dumps));
 }
 
+// NB: The reader document waits among the page dumps, which take the same kind of answer.
+void HubConnection::view_reader_document(u64 view_id, u64 request_id, Optional<String> html)
+{
+    if (auto* view = RemoteView::find(view_id))
+        view->did_get_page_dumps(request_id, move(html));
+}
+
 void HubConnection::fetch_platform_features_description(Function<void(ByteString)> callback)
 {
     auto request_id = m_next_request_id++;
