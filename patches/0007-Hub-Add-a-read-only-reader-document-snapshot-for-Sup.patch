From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Superbird <superbird@local>
Date: Tue, 24 Nov 2026 18:42:24 -0600
Subject: [PATCH] Hub: Add a read-only reader document snapshot for Superbird
 Reader View


diff --git a/Libraries/LibWebCommon/WebView/PageInfo.h b/Libraries/LibWebCommon/WebView/PageInfo.h
index d80804d8..64309454 100644
--- a/Libraries/LibWebCommon/WebView/PageInfo.h
+++ b/Libraries/LibWebCommon/WebView/PageInfo.h
@@ -17,6 +17,8 @@ enum class PageInfoType {
     StackingContextTree = 1 << 5,
     AccessibilityTree = 1 << 6,
     DisplayList = 1 << 7,
+    // The active document serialized as HTML, for Superbird's Reader View.
+    DocumentHTML = 1 << 8,
 };
 
 AK_ENUM_BITWISE_OPERATORS(PageInfoType);
diff --git a/Services/Hub/ConnectionFromUI.cpp b/Services/Hub/ConnectionFromUI.cpp
index 43435a1b..4020868b 100644
--- a/Services/Hub/ConnectionFromUI.cpp
+++ b/Services/Hub/ConnectionFromUI.cpp
@@ -545,6 +545,23 @@ void ConnectionFromUI::view_request_page_dumps(u64 view_id, u64 request_id)
     });
 }
 
+// The page's document as HTML, read-only, for Superbird's Reader View to extract its article from.
+void ConnectionFromUI::view_request_reader_document(u64 view_id, u64 request_id)
+{
+    auto* view = find_view(view_id);
+    if (!view) {
+        async_view_reader_document(view_id, request_id, {});
+        return;
+    }
+    auto promise = view->request_internal_page_info(WebView::PageInfoType::DocumentHTML);
+    promise->when_resolved([this, view_id, request_id](String& html) {
+        async_view_reader_document(view_id, request_id, html);
+    });
+    promise->when_rejected([this, view_id, request_id](Error const&) {
+        async_view_reader_document(view_id, request_id, {});
+    });
+}
+
 void ConnectionFromUI::request_platform_features_description(u64 request_id)
 {
     async_platform_features_description(request_id, Application::the().describe_platform_features_for_report({}));
