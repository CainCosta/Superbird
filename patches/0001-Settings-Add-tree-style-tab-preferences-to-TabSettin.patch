From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sidelady <sidelady@local>
Date: Mon, 23 Nov 2026 22:09:03 -0600
Subject: [PATCH] Settings: Add tree-style tab preferences to TabSettings and
 about:settings


diff --git a/Base/res/ladybird/about-pages/settings.html b/Base/res/ladybird/about-pages/settings.html
index bb3ccc09..fcb2051c 100644
--- a/Base/res/ladybird/about-pages/settings.html
+++ b/Base/res/ladybird/about-pages/settings.html
@@ -1092,6 +1092,36 @@
                                 </label>
                             </div>
                         </div>
+                        <div class="card-group inline-container control-row hidden">
+                            <label for="tree-tabs-enabled">
+                                Organize tabs as a tree
+                                <p class="description">
+                                    Nest tabs opened from links underneath their parent tab in the sidebar.
+                                </p>
+                            </label>
+                            <input id="tree-tabs-enabled" type="checkbox" switch />
+                        </div>
+                        <div class="card-group inline-container control-row hidden">
+                            <label for="tree-tabs-close-behavior">When closing a parent tab</label>
+                            <select id="tree-tabs-close-behavior">
+                                <option value="promoteFirstChild">Promote first child</option>
+                                <option value="attachToGrandparent">Attach children to grandparent</option>
+                                <option value="closeBranch">Close whole branch</option>
+                            </select>
+                        </div>
+                        <div class="card-group inline-container control-row hidden">
+                            <label for="tree-tabs-child-position">New child tabs open</label>
+                            <select id="tree-tabs-child-position">
+                                <option value="bottom">At the bottom of the branch</option>
+                                <option value="top">At the top of the branch</option>
+                            </select>
+                        </div>
+                        <div class="card-group inline-container control-row hidden">
+                            <label for="tree-tabs-auto-collapse-siblings">
+                                Collapse other branches when expanding one
+                            </label>
+                            <input id="tree-tabs-auto-collapse-siblings" type="checkbox" switch />
+                        </div>
                         <div class="card-group inline-container control-row hidden">
                             <label for="vertical-tabs-expand-on-hover">
                                 Expand vertical tabs on hover when collapsed
diff --git a/Base/res/ladybird/about-pages/settings/tabs.js b/Base/res/ladybird/about-pages/settings/tabs.js
index a9d41841..a2d2f6df 100644
--- a/Base/res/ladybird/about-pages/settings/tabs.js
+++ b/Base/res/ladybird/about-pages/settings/tabs.js
@@ -1,5 +1,9 @@
 const tabLayoutGroup = document.querySelector("#tab-layout-group");
 const tabLayoutInputs = tabLayoutGroup.querySelectorAll('input[name="tab-layout"]');
+const treeTabsEnabled = document.querySelector("#tree-tabs-enabled");
+const treeTabsCloseBehavior = document.querySelector("#tree-tabs-close-behavior");
+const treeTabsChildPosition = document.querySelector("#tree-tabs-child-position");
+const treeTabsAutoCollapseSiblings = document.querySelector("#tree-tabs-auto-collapse-siblings");
 const verticalTabsExpandOnHover = document.querySelector("#vertical-tabs-expand-on-hover");
 const verticalTabsPosition = document.querySelector("#vertical-tabs-position");
 const showBookmarksBar = document.querySelector("#show-bookmarks-bar");
@@ -12,6 +16,10 @@ const loadFeatures = features => {
     // Without vertical tabs, there is no choice of tab layout to make.
     tabLayoutGroup.classList.toggle("hidden", !features?.verticalTabs);
     if (!features?.verticalTabs) {
+        treeTabsEnabled.parentElement.classList.add("hidden");
+        treeTabsCloseBehavior.parentElement.classList.add("hidden");
+        treeTabsChildPosition.parentElement.classList.add("hidden");
+        treeTabsAutoCollapseSiblings.parentElement.classList.add("hidden");
         verticalTabsExpandOnHover.parentElement.classList.add("hidden");
         verticalTabsPosition.parentElement.classList.add("hidden");
     }
@@ -19,6 +27,11 @@ const loadFeatures = features => {
 
 const updateVerticalTabsDependentSettings = () => {
     const verticalTabsEnabled = !!TAB_SETTINGS.verticalTabsEnabled && !tabLayoutGroup.classList.contains("hidden");
+    const treeTabsActive = verticalTabsEnabled && !!TAB_SETTINGS.treeTabsEnabled;
+    treeTabsEnabled.parentElement.classList.toggle("hidden", !verticalTabsEnabled);
+    treeTabsCloseBehavior.parentElement.classList.toggle("hidden", !treeTabsActive);
+    treeTabsChildPosition.parentElement.classList.toggle("hidden", !treeTabsActive);
+    treeTabsAutoCollapseSiblings.parentElement.classList.toggle("hidden", !treeTabsActive);
     verticalTabsExpandOnHover.parentElement.classList.toggle("hidden", !verticalTabsEnabled);
     // With everything in the sidebar, the sidebar is always on the left.
     verticalTabsPosition.parentElement.classList.toggle(
@@ -45,6 +58,10 @@ const loadSettings = settings => {
 
     const layout = tabLayout();
     for (const input of tabLayoutInputs) input.checked = input.value === layout;
+    treeTabsEnabled.checked = !!TAB_SETTINGS.treeTabsEnabled;
+    treeTabsCloseBehavior.value = TAB_SETTINGS.treeTabsCloseBehavior || "promoteFirstChild";
+    treeTabsChildPosition.value = TAB_SETTINGS.treeTabsChildPosition || "bottom";
+    treeTabsAutoCollapseSiblings.checked = !!TAB_SETTINGS.treeTabsAutoCollapseSiblings;
     verticalTabsExpandOnHover.checked = !!TAB_SETTINGS.verticalTabsExpandOnHover;
     verticalTabsPosition.value = TAB_SETTINGS.verticalTabsPosition || "left";
     const discardMinutes = String(TAB_SETTINGS.discardHiddenTabsAfterMinutes ?? 120);
@@ -71,6 +88,27 @@ for (const input of tabLayoutInputs) {
     });
 }
 
+treeTabsEnabled.addEventListener("change", () => {
+    TAB_SETTINGS.treeTabsEnabled = treeTabsEnabled.checked;
+    updateVerticalTabsDependentSettings();
+    saveTabSettings();
+});
+
+treeTabsCloseBehavior.addEventListener("change", () => {
+    TAB_SETTINGS.treeTabsCloseBehavior = treeTabsCloseBehavior.value;
+    saveTabSettings();
+});
+
+treeTabsChildPosition.addEventListener("change", () => {
+    TAB_SETTINGS.treeTabsChildPosition = treeTabsChildPosition.value;
+    saveTabSettings();
+});
+
+treeTabsAutoCollapseSiblings.addEventListener("change", () => {
+    TAB_SETTINGS.treeTabsAutoCollapseSiblings = treeTabsAutoCollapseSiblings.checked;
+    saveTabSettings();
+});
+
 verticalTabsExpandOnHover.addEventListener("change", () => {
     TAB_SETTINGS.verticalTabsExpandOnHover = verticalTabsExpandOnHover.checked;
     saveTabSettings();
diff --git a/Libraries/LibWebView/Settings.cpp b/Libraries/LibWebView/Settings.cpp
index 5afb3756..458d099a 100644
--- a/Libraries/LibWebView/Settings.cpp
+++ b/Libraries/LibWebView/Settings.cpp
@@ -61,6 +61,10 @@ static constexpr auto VERTICAL_TABS_EXPAND_ON_HOVER_KEY = "verticalTabsExpandOnH
 static constexpr auto VERTICAL_TABS_POSITION_KEY = "verticalTabsPosition"sv;
 static constexpr auto VERTICAL_TABS_EXPANDED_WIDTH_KEY = "verticalTabsExpandedWidth"sv;
 static constexpr auto EVERYTHING_IN_SIDEBAR_KEY = "everythingInSidebar"sv;
+static constexpr auto TREE_TABS_ENABLED_KEY = "treeTabsEnabled"sv;
+static constexpr auto TREE_TABS_CLOSE_BEHAVIOR_KEY = "treeTabsCloseBehavior"sv;
+static constexpr auto TREE_TABS_CHILD_POSITION_KEY = "treeTabsChildPosition"sv;
+static constexpr auto TREE_TABS_AUTO_COLLAPSE_SIBLINGS_KEY = "treeTabsAutoCollapseSiblings"sv;
 static constexpr auto DISCARD_HIDDEN_TABS_AFTER_MINUTES_KEY = "discardHiddenTabsAfterMinutes"sv;
 static constexpr auto TAB_PROCESSES_KEY = "tabProcesses"sv;
 
@@ -332,6 +336,50 @@ static constexpr Optional<ColorTheme> color_theme_from_string(StringView theme)
     return {};
 }
 
+static constexpr StringView tree_tab_close_behavior_to_string(TreeTabCloseBehavior behavior)
+{
+    switch (behavior) {
+    case TreeTabCloseBehavior::PromoteFirstChild:
+        return "promoteFirstChild"sv;
+    case TreeTabCloseBehavior::AttachToGrandparent:
+        return "attachToGrandparent"sv;
+    case TreeTabCloseBehavior::CloseBranch:
+        return "closeBranch"sv;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+static constexpr Optional<TreeTabCloseBehavior> tree_tab_close_behavior_from_string(StringView behavior)
+{
+    if (behavior == "promoteFirstChild"sv)
+        return TreeTabCloseBehavior::PromoteFirstChild;
+    if (behavior == "attachToGrandparent"sv)
+        return TreeTabCloseBehavior::AttachToGrandparent;
+    if (behavior == "closeBranch"sv)
+        return TreeTabCloseBehavior::CloseBranch;
+    return {};
+}
+
+static constexpr StringView tree_tab_child_position_to_string(TreeTabChildPosition position)
+{
+    switch (position) {
+    case TreeTabChildPosition::Top:
+        return "top"sv;
+    case TreeTabChildPosition::Bottom:
+        return "bottom"sv;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+static constexpr Optional<TreeTabChildPosition> tree_tab_child_position_from_string(StringView position)
+{
+    if (position == "top"sv)
+        return TreeTabChildPosition::Top;
+    if (position == "bottom"sv)
+        return TreeTabChildPosition::Bottom;
+    return {};
+}
+
 static constexpr StringView vertical_tabs_position_to_string(VerticalTabsPosition position)
 {
     switch (position) {
@@ -876,6 +924,10 @@ JsonValue Settings::serialize_json() const
     if (m_tab_settings.vertical_tabs_expanded_width.has_value())
         tab_settings.set(VERTICAL_TABS_EXPANDED_WIDTH_KEY, *m_tab_settings.vertical_tabs_expanded_width);
     tab_settings.set(EVERYTHING_IN_SIDEBAR_KEY, m_tab_settings.everything_in_sidebar);
+    tab_settings.set(TREE_TABS_ENABLED_KEY, m_tab_settings.tree_tabs_enabled);
+    tab_settings.set(TREE_TABS_CLOSE_BEHAVIOR_KEY, tree_tab_close_behavior_to_string(m_tab_settings.tree_tabs_close_behavior));
+    tab_settings.set(TREE_TABS_CHILD_POSITION_KEY, tree_tab_child_position_to_string(m_tab_settings.tree_tabs_child_position));
+    tab_settings.set(TREE_TABS_AUTO_COLLAPSE_SIBLINGS_KEY, m_tab_settings.tree_tabs_auto_collapse_siblings);
     tab_settings.set(DISCARD_HIDDEN_TABS_AFTER_MINUTES_KEY, m_tab_settings.discard_hidden_tabs_after_minutes);
     tab_settings.set(TAB_PROCESSES_KEY, tab_processes_to_string(m_tab_settings.tab_processes));
     settings.set(TAB_SETTINGS_KEY, move(tab_settings));
@@ -1301,6 +1353,18 @@ TabSettings Settings::parse_tab_settings(JsonValue const& settings)
         tab_settings.vertical_tabs_expanded_width = *vertical_tabs_expanded_width;
     if (auto everything_in_sidebar = settings.as_object().get_bool(EVERYTHING_IN_SIDEBAR_KEY); everything_in_sidebar.has_value())
         tab_settings.everything_in_sidebar = *everything_in_sidebar;
+    if (auto tree_tabs_enabled = settings.as_object().get_bool(TREE_TABS_ENABLED_KEY); tree_tabs_enabled.has_value())
+        tab_settings.tree_tabs_enabled = *tree_tabs_enabled;
+    if (auto tree_tabs_close_behavior = settings.as_object().get_string(TREE_TABS_CLOSE_BEHAVIOR_KEY); tree_tabs_close_behavior.has_value()) {
+        if (auto parsed = tree_tab_close_behavior_from_string(*tree_tabs_close_behavior); parsed.has_value())
+            tab_settings.tree_tabs_close_behavior = *parsed;
+    }
+    if (auto tree_tabs_child_position = settings.as_object().get_string(TREE_TABS_CHILD_POSITION_KEY); tree_tabs_child_position.has_value()) {
+        if (auto parsed = tree_tab_child_position_from_string(*tree_tabs_child_position); parsed.has_value())
+            tab_settings.tree_tabs_child_position = *parsed;
+    }
+    if (auto tree_tabs_auto_collapse = settings.as_object().get_bool(TREE_TABS_AUTO_COLLAPSE_SIBLINGS_KEY); tree_tabs_auto_collapse.has_value())
+        tab_settings.tree_tabs_auto_collapse_siblings = *tree_tabs_auto_collapse;
     if (auto minutes = settings.as_object().get_integer<u32>(DISCARD_HIDDEN_TABS_AFTER_MINUTES_KEY); minutes.has_value())
         tab_settings.discard_hidden_tabs_after_minutes = *minutes;
     if (auto tab_processes = settings.as_object().get_string(TAB_PROCESSES_KEY); tab_processes.has_value()) {
diff --git a/Libraries/LibWebView/Settings.h b/Libraries/LibWebView/Settings.h
index 798e2eee..7f054f01 100644
--- a/Libraries/LibWebView/Settings.h
+++ b/Libraries/LibWebView/Settings.h
@@ -98,6 +98,17 @@ enum class VerticalTabsPosition : u8 {
     Right,
 };
 
+enum class TreeTabCloseBehavior : u8 {
+    PromoteFirstChild,
+    AttachToGrandparent,
+    CloseBranch,
+};
+
+enum class TreeTabChildPosition : u8 {
+    Top,
+    Bottom,
+};
+
 struct TabSettings {
     bool vertical_tabs_enabled { false };
     bool vertical_tabs_expanded { true };
@@ -106,6 +117,10 @@ struct TabSettings {
     // With vertical tabs, the open sidebar also holds the navigation buttons, the address field and the toolbar's other
     // buttons, and there is no toolbar row. The sidebar is then always on the left.
     bool everything_in_sidebar { false };
+    bool tree_tabs_enabled { false };
+    TreeTabCloseBehavior tree_tabs_close_behavior { TreeTabCloseBehavior::PromoteFirstChild };
+    TreeTabChildPosition tree_tabs_child_position { TreeTabChildPosition::Bottom };
+    bool tree_tabs_auto_collapse_siblings { false };
     Optional<u16> vertical_tabs_expanded_width;
     // A tab that was hidden for this many minutes is discarded, unless it does something the user would notice. Zero
     // means that tabs are kept however long they are hidden.
